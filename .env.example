# NextAuth v4 Authentication Configuration
# Generate a secret using: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_32_chars_or_more
NEXTAUTH_URL=https://spreadsheet-rust.vercel.app

# Google OAuth 2.0 Credentials
# From Google Cloud Console: APIs & Services -> Credentials -> OAuth 2.0 Client IDs
# Authorized Redirect URI: https://spreadsheet-rust.vercel.app/api/auth/callback/google
# (For local dev: http://localhost:3000/api/auth/callback/google)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Administrator Allowlist (Authoritative Server-Side Control)
# Comma-separated list of Google email addresses granted Admin privileges
ADMIN_EMAILS=arsal73500@gmail.com,admin@example.com

# GitHub Persistent Storage Configuration
# Personal Access Token (classic or fine-grained) with 'repo' scope
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_OWNER=arsal73500-beep
GITHUB_REPO=Spreadsheet
GITHUB_BRANCH=main

# App Configuration
NEXT_PUBLIC_APP_URL=https://spreadsheet-rust.vercel.app
